{
  "name": "@kne/fastify-app-manager",
  "version": "0.1.7",
  "description": "Fastify 单机应用市场插件：版本上传、PM2 托管、路径/域名反代与日志 SSE",
  "main": "index.js",
  "scripts": {
    "init": "husky",
    "build:md": "npx @kne/md-doc",
    "start:md": "npx @kne/md-doc --watch",
    "test": "mocha test/**/*.test.js",
    "test:coverage": "nyc --reporter=html --reporter=text mocha test/**/*.test.js",
    "prettier": "prettier --config .prettierrc --write '{libs/**/*,index,test/**/*}.{js,jsx,ts,tsx,json,css,scss}'",
    "lint-staged": "npx lint-staged"
  },
  "lint-staged": {
    "{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}": [
      "prettier --config .prettierrc --write",
      "git add"
    ]
  },
  "files": [
    "index.js",
    "libs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kne-union/fastify-app-manager.git"
  },
  "keywords": [
    "fastify",
    "pm2",
    "app-manager",
    "marketplace",
    "reverse-proxy",
    "gateway",
    "sse",
    "deployment",
    "kne"
  ],
  "author": "linzp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kne-union/fastify-app-manager/issues"
  },
  "homepage": "https://github.com/kne-union/fastify-app-manager#readme",
  "peerDependencies": {
    "@kne/fastify-namespace": "*",
    "@kne/fastify-sequelize": "*",
    "fastify-plugin": ">=5"
  },
  "devDependencies": {
    "@fastify/env": "^5.0.2",
    "@fastify/sensible": "^6.0.5",
    "@kne/fastify-namespace": "^1.2.1",
    "@kne/fastify-sequelize": "^4.0.3",
    "chai": "^6.2.2",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "husky": "^9.0.11",
    "mocha": "^12.0.0",
    "nodemon": "^3.1.3",
    "nyc": "^18.0.0",
    "prettier": "^3.2.5",
    "proxyquire": "^2.1.3",
    "sqlite3": "^5.1.7"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/reply-from": "^12.6.5",
    "@kne/ensure-slash": "^0.1.0",
    "adm-zip": "^0.6.0",
    "fs-extra": "^11.4.0",
    "jsdom": "^29.1.1",
    "lodash": "^4.18.1",
    "pm2": "^7.0.4",
    "sequelize": "^6.37.7"
  }
}
